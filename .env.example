# ============================================================
# BIOTECH LIFE SCIENCES — environment variables
# Copy to .env.local for local development. PLACEHOLDERS ONLY —
# never commit real values. .env.local is git-ignored.
# ============================================================

# ---- Site ----
# Used for canonical URLs, Open Graph and sitemap. Set to the live domain.
NEXT_PUBLIC_SITE_URL=https://biotechlifesciences.uk

# ---- Supabase --------------------------------------------------
# Dashboard → Project Settings → API
#
# SAFE IN THE BROWSER. Protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
#
# SECRET — SERVER ONLY. Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_. Never paste into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Google Sheets sync (optional) ------------------------------
# Leave blank to disable; the site works without it.
#
# The spreadsheet ID is the long string in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# SECRET — SERVER ONLY. The full service-account JSON, either raw or
# base64-encoded (base64 avoids newline mangling in dashboards):
#   base64 -i service-account.json | pbcopy
# Remember to share the sheet with the service account's client_email
# as an Editor, or writes will 403.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Payments (optional) ----------------------------------------
# UPI virtual payment address shown at checkout, e.g. business@okhdfcbank
NEXT_PUBLIC_UPI_VPA=

# ---- Shopify (provisioned by the Vercel Marketplace integration) --
# Run `vercel env pull` to fetch these; do not hand-edit.
# Shopify owns catalog, cart, checkout and payments.
#
# Store address, e.g. your-store.myshopify.com — not sensitive.
SHOPIFY_STORE_DOMAIN=
# Read-only Storefront API token. SERVER ONLY — note there is no
# NEXT_PUBLIC_ prefix: all Storefront calls run server-side.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
